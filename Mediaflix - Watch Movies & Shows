// --- FIREBASE CONFIGURATION & SAFE FALLBACK INITIALIZATION ---
import { initializeApp } from "firebase/app";
import { 
  getAuth, signInWithCustomToken, signInAnonymously, onAuthStateChanged, signOut 
} from "firebase/auth";
import { 
  getFirestore, doc, setDoc, getDoc, collection, onSnapshot, deleteDoc 
} from "firebase/firestore";

let db = null;
let auth = null;
let appId = "mediaflix-app";
let isFirebaseEnabled = false;

try {
  if (typeof __firebase_config !== "undefined" && __firebase_config) {
    const firebaseConfig = JSON.parse(__firebase_config);
    const app = initializeApp(firebaseConfig);
    auth = getAuth(app);
    db = getFirestore(app);
    appId = typeof __app_id !== "undefined" ? __app_id : "mediaflix-app";
    isFirebaseEnabled = true;
  }
} catch (e) {
  console.warn("Firebase not fully configured or using offline fallback:", e);
}

